{
  "kind": "ForgeFixture",
  "schemaVersion": 2,
  "name": "collect-fruit-generated-seed",
  "luauRoots": ["src"],
  "instances": [
    { "path": "ReplicatedStorage/Remotes", "className": "Folder", "tags": ["network"] },
    { "path": "ReplicatedStorage/Remotes/CollectFruit", "className": "RemoteEvent", "parentPath": "ReplicatedStorage/Remotes" },
    { "path": "Workspace/Fruit42", "className": "Part", "properties": { "CanTouch": true }, "attributes": { "FruitType": "Apple", "Reward": 1, "Consumed": false }, "tags": ["collectible"] }
  ],
  "persistentState": [{ "field": "Inventory", "type": "number", "owner": "server", "durability": "session" }],
  "uiBindings": [],
  "remoteFlows": [
    {
      "name": "CollectFruit",
      "direction": "client_to_server",
      "remote": { "stableId": "remote_collect_fruit", "path": "ReplicatedStorage/Remotes/CollectFruit", "className": "RemoteEvent", "preserveExisting": true },
      "clientScript": "src/client/CollectFruitClient.client.luau",
      "serverScript": "src/server/CollectFruit.server.luau",
      "clientInputs": [
        { "position": 1, "role": "fruit_id", "type": "string", "trust": "untrusted" },
        { "position": 2, "role": "claimed_reward", "type": "number", "trust": "untrusted" }
      ],
      "serverArguments": [
        { "position": 0, "role": "player", "type": "Player", "source": "roblox_server" },
        { "position": 1, "role": "fruit_id", "type": "string", "source": "client" },
        { "position": 2, "role": "claimed_reward", "type": "number", "source": "client" }
      ],
      "validationRequirements": [
        { "category": "type", "subjectRole": "fruit_id", "applicability": "required", "rationale": "The identifier is untrusted." },
        { "category": "value", "subjectRole": "fruit_id", "applicability": "required", "rationale": "Only an existing collectible may be selected." },
        { "category": "type", "subjectRole": "claimed_reward", "applicability": "required", "rationale": "Adversarial input must be handled safely." },
        { "category": "value", "subjectRole": "claimed_reward", "applicability": "required", "rationale": "Non-finite and negative claims are invalid." },
        { "category": "context", "subjectRole": "interaction", "applicability": "required", "rationale": "The server must establish collectible and distance context." },
        { "category": "permission", "subjectRole": "interaction", "applicability": "required", "rationale": "The active player context is supplied and checked server-side." },
        { "category": "ownership", "subjectRole": "target", "applicability": "not_applicable", "rationale": "Fruit is globally collectible." }
      ],
      "mutation": { "field": "Inventory", "sourceExpression": "server_owned_reward", "authority": "server" },
      "implementation": {
        "stateBindings": [
          { "role": "inventory", "subject": "player", "storage": "attribute", "name": "Inventory", "type": "number", "authority": "server" },
          { "role": "availability", "subject": "target", "storage": "attribute", "name": "Consumed", "type": "boolean", "authority": "server" },
          { "role": "reward", "subject": "target", "storage": "attribute", "name": "Reward", "type": "number", "authority": "server" },
          { "role": "collectible", "subject": "target", "storage": "tag", "name": "collectible", "type": "boolean", "authority": "server" }
        ],
        "constants": [
          { "role": "canonical_target_id", "type": "string", "value": "Fruit42" },
          { "role": "max_interaction_distance", "type": "number", "value": 20 }
        ],
        "postconditions": ["The selected fruit becomes consumed.", "Inventory increases exactly once by the target's Reward attribute."],
        "authorityInvariants": ["The client cannot choose the reward.", "The client cannot mutate Inventory or Consumed state.", "The existing RemoteEvent must not be recreated or moved."]
      }
    }
  ]
}
