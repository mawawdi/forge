{
  "kind": "ForgeFixture",
  "schemaVersion": 1,
  "name": "collect-fruit-vulnerable",
  "luauRoots": ["src"],
  "instances": [
    { "path": "ReplicatedStorage/Remotes", "className": "Folder", "tags": ["network"] },
    { "path": "ReplicatedStorage/Remotes/CollectFruit", "className": "RemoteEvent", "parentPath": "ReplicatedStorage/Remotes" },
    { "path": "Workspace/Fruit", "className": "Part", "properties": { "CanTouch": true }, "attributes": { "FruitType": "Apple" }, "tags": ["collectible"] }
  ],
  "persistentState": [{ "field": "Inventory", "type": "number", "owner": "server", "durability": "session" }],
  "uiBindings": [{ "path": "StarterGui.InventoryCount", "sourceField": "Inventory", "direction": "server_to_client" }],
  "remoteFlows": [
    {
      "name": "CollectFruit",
      "direction": "client_to_server",
      "clientScript": "src/client/CollectFruit.client.luau",
      "serverScript": "src/server/CollectFruit.server.luau",
      "clientInput": { "name": "amount", "type": "number" },
      "serverValidations": ["type", "value"],
      "mutation": { "field": "Inventory", "sourceExpression": "server_owned_reward", "authority": "server" }
    }
  ]
}
