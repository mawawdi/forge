{
  "kind": "ForgeFixture",
  "schemaVersion": 2,
  "name": "collect-fruit-vulnerable",
  "luauRoots": ["src"],
  "instances": [
    { "path": "ReplicatedStorage/Remotes", "className": "Folder", "tags": ["network"] },
    { "path": "ReplicatedStorage/Remotes/CollectFruit", "className": "RemoteEvent", "parentPath": "ReplicatedStorage/Remotes" },
    { "path": "Workspace/Fruit", "className": "Part", "properties": { "CanTouch": true }, "attributes": { "FruitType": "Apple" }, "tags": ["collectible"] }
  ],
  "persistentState": [{ "field": "Inventory", "type": "number", "owner": "server", "durability": "session" }],
  "uiBindings": [{ "path": "StarterGui.InventoryCount", "sourceField": "Inventory", "direction": "server_to_client" }],
  "remoteFlows": [
    {
      "name": "CollectFruit",
      "direction": "client_to_server",
      "remote": { "stableId": "remote_collect_fruit", "path": "ReplicatedStorage/Remotes/CollectFruit", "className": "RemoteEvent", "preserveExisting": true },
      "clientScript": "src/client/CollectFruit.client.luau",
      "serverScript": "src/server/CollectFruit.server.luau",
      "clientInputs": [{ "position": 1, "role": "claimed_reward", "type": "number", "trust": "untrusted" }],
      "serverArguments": [
        { "position": 0, "role": "player", "type": "Player", "source": "roblox_server" },
        { "position": 1, "role": "claimed_reward", "type": "number", "source": "client" }
      ],
      "validationRequirements": [
        { "category": "type", "subjectRole": "claimed_reward", "applicability": "required", "rationale": "The claim crosses an untrusted remote boundary." },
        { "category": "value", "subjectRole": "claimed_reward", "applicability": "required", "rationale": "Only positive requests are accepted." }
      ],
      "mutation": { "field": "Inventory", "sourceExpression": "server_owned_reward", "authority": "server" },
      "implementation": {
        "stateBindings": [{ "role": "inventory", "subject": "player", "storage": "table", "name": "Inventory", "type": "number", "authority": "server" }],
        "constants": [{ "role": "server_reward", "type": "number", "value": 1 }],
        "postconditions": ["Inventory increases by one server-owned reward."],
        "authorityInvariants": ["The untrusted client claim cannot determine the inventory delta.", "The existing remote is preserved."]
      }
    }
  ]
}
